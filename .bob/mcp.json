{
  "mcpServers": {
    "jakarta-discovery": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "tools/jakarta-discovery/jakarta_discovery_server.py"
      ],
      "cwd": ".",
      "alwaysAllow": [
        "scan_javax_usage",
        "descriptor_audit",
        "scan_config_literals",
        "parse_dependency_tree"
      ]
    },
    "jakarta-impact": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "tools/run_jakarta_impact_server.py"
      ],
      "cwd": ".",
      "alwaysAllow": [
        "analyze_impact",
        "find_judgment_call_candidates"
      ]
    },
    "jakarta-plan": {
      "command": "uv",
      "args": [
        "run",
        "python",
        "tools/run_jakarta_plan_server.py"
      ],
      "cwd": ".",
      "alwaysAllow": [
        "plan_migration"
      ]
    }
  }
}
