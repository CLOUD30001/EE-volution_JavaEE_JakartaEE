<server description="javaee8-order-management Liberty server">

    <!-- Convenience feature bundling the full Java EE 8 platform: Servlet 4.0, JSP 2.3,
         JSF 2.3, EJB 3.2, CDI 2.0, JPA 2.2, Bean Validation 2.0, JAX-RS 2.1, JAX-WS 2.3,
         JSON-B 1.0, WebSocket 1.1, Concurrency Utilities 1.0, Java EE Security API 1.0,
         Common Annotations 1.3. If any individual feature turns out missing on your
         install, swap this for the equivalent list of specific -8.0/-2.x features. -->
    <featureManager>
        <feature>javaee-8.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint" host="*"
                  httpPort="${default.http.port}"
                  httpsPort="${default.https.port}"/>

    <!-- Embedded Derby datasource backing the JPA persistence unit (jdbc/OrderManagementDS
         in persistence.xml). The Derby driver jar is copied into shared.resource.dir/derby
         by the liberty-maven-plugin's copyDependencies config in pom.xml. -->
    <library id="derbyJDBCLib">
        <fileset dir="${shared.resource.dir}/derby" includes="*.jar"/>
    </library>

    <dataSource jndiName="jdbc/OrderManagementDS">
        <jdbcDriver libraryRef="derbyJDBCLib"/>
        <properties.derby.embedded databaseName="${server.output.dir}/data/OrderManagementDB" createDatabase="create"/>
    </dataSource>

    <webApplication location="javaee8-order-management.war" contextRoot="/javaee8-order-management"/>

</server>
